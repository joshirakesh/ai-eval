<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>AI Evaluation System — Architecture Diagram (ADO #18479)</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    background: #0F172A;
    font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    overflow: hidden;
    user-select: none;
    color: #E2E8F0;
  }
  #toolbar {
    position: fixed;
    top: 16px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 100;
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(15,23,42,0.92);
    border: 1px solid rgba(148,163,184,0.25);
    border-radius: 12px;
    padding: 8px 16px;
    backdrop-filter: blur(12px);
    box-shadow: 0 8px 32px rgba(0,0,0,0.5);
  }
  #toolbar h1 {
    font-size: 13px;
    font-weight: 600;
    color: #94A3B8;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
  #toolbar .sep { width: 1px; height: 20px; background: rgba(148,163,184,0.25); }
  .tb-btn {
    background: rgba(51,65,85,0.8);
    border: 1px solid rgba(148,163,184,0.2);
    color: #E2E8F0;
    border-radius: 7px;
    width: 30px; height: 30px;
    font-size: 16px;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: background 0.15s;
  }
  .tb-btn:hover { background: rgba(71,85,105,0.9); }
  #btnTooltipToggle {
    width: auto;
    padding: 0 10px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
  #zoomDisplay {
    font-size: 12px;
    color: #94A3B8;
    min-width: 42px;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }
  #canvas-wrap {
    width: 100vw;
    height: 100vh;
    cursor: grab;
    overflow: hidden;
    position: relative;
  }
  #canvas-wrap.dragging { cursor: grabbing; }
  #svg-root {
    position: absolute;
    transform-origin: 0 0;
  }

  /* Tooltip */
  #tooltip {
    position: fixed;
    z-index: 200;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.18s;
    max-width: 300px;
  }
  #tooltip.visible { opacity: 1; }
  #tooltip-inner {
    background: rgba(15,23,42,0.97);
    border: 1px solid rgba(148,163,184,0.3);
    border-radius: 10px;
    padding: 10px 13px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.6);
    font-size: 12px;
    line-height: 1.55;
    color: #CBD5E1;
  }
  #tooltip-inner strong {
    display: block;
    font-size: 13px;
    color: #F1F5F9;
    margin-bottom: 4px;
  }
</style>
</head>
<body>

<div id="toolbar">
  <h1>AI Evaluation System — ADO #18479</h1>
  <div class="sep"></div>
  <button class="tb-btn" id="btnZoomOut" title="Zoom out">−</button>
  <span id="zoomDisplay">100%</span>
  <button class="tb-btn" id="btnZoomIn" title="Zoom in">+</button>
  <button class="tb-btn" id="btnReset" title="Reset view" style="font-size:13px;">⌂</button>
  <div class="sep"></div>
  <button class="tb-btn" id="btnTooltipToggle" title="Toggle tooltips — hover cards to see details">💬 Tooltips: OFF</button>
</div>

<div id="canvas-wrap">
  <svg id="svg-root" width="1700" height="1060" viewBox="0 0 1700 1060"
       xmlns="http://www.w3.org/2000/svg">
    <defs>
      <!-- Drop shadow filters -->
      <filter id="shadow-sm" x="-10%" y="-10%" width="120%" height="120%">
        <feDropShadow dx="0" dy="2" stdDeviation="4" flood-color="#000" flood-opacity="0.35"/>
      </filter>
      <filter id="shadow-md" x="-15%" y="-15%" width="130%" height="130%">
        <feDropShadow dx="0" dy="4" stdDeviation="8" flood-color="#000" flood-opacity="0.4"/>
      </filter>
      <filter id="shadow-lg" x="-20%" y="-20%" width="140%" height="140%">
        <feDropShadow dx="0" dy="6" stdDeviation="14" flood-color="#000" flood-opacity="0.45"/>
      </filter>

      <!-- Gradients for group headers -->
      <linearGradient id="grad-blue" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#1E40AF"/>
        <stop offset="100%" stop-color="#1D4ED8"/>
      </linearGradient>
      <linearGradient id="grad-green" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#065F46"/>
        <stop offset="100%" stop-color="#047857"/>
      </linearGradient>
      <linearGradient id="grad-red" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#7F1D1D"/>
        <stop offset="100%" stop-color="#991B1B"/>
      </linearGradient>
      <linearGradient id="grad-violet" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#4C1D95"/>
        <stop offset="100%" stop-color="#5B21B6"/>
      </linearGradient>
      <linearGradient id="grad-amber" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#78350F"/>
        <stop offset="100%" stop-color="#92400E"/>
      </linearGradient>

      <!-- Card gradients (light) -->
      <linearGradient id="card-blue" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#1E3A5F"/>
        <stop offset="100%" stop-color="#172A45"/>
      </linearGradient>
      <linearGradient id="card-green" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#064E3B"/>
        <stop offset="100%" stop-color="#052E23"/>
      </linearGradient>
      <linearGradient id="card-red" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#7F1D1D"/>
        <stop offset="100%" stop-color="#5A0E0E"/>
      </linearGradient>
      <linearGradient id="card-violet" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#3B0764"/>
        <stop offset="100%" stop-color="#250448"/>
      </linearGradient>
      <linearGradient id="card-amber" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#78350F"/>
        <stop offset="100%" stop-color="#4D2006"/>
      </linearGradient>

      <!-- Arrow markers -->
      <marker id="arrow-gray" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto">
        <polygon points="0 0, 10 3.5, 0 7" fill="#64748B"/>
      </marker>
      <marker id="arrow-blue" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto">
        <polygon points="0 0, 10 3.5, 0 7" fill="#60A5FA"/>
      </marker>
      <marker id="arrow-green" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto">
        <polygon points="0 0, 10 3.5, 0 7" fill="#34D399"/>
      </marker>
      <marker id="arrow-amber" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto">
        <polygon points="0 0, 10 3.5, 0 7" fill="#FBBF24"/>
      </marker>
      <marker id="arrow-violet" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto">
        <polygon points="0 0, 10 3.5, 0 7" fill="#A78BFA"/>
      </marker>
    </defs>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- BACKGROUND GRID (subtle) -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <rect width="1700" height="1060" fill="#0F172A"/>
    <defs>
      <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
        <path d="M 40 0 L 0 0 0 40" fill="none" stroke="rgba(148,163,184,0.04)" stroke-width="1"/>
      </pattern>
    </defs>
    <rect width="1700" height="1060" fill="url(#grid)"/>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- SECTION 1: BENCHMARK DATA (top-right, amber)                       -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- Section height capped at 290 — stays well above Azure Services (y=358) -->
    <rect x="1195" y="28" width="470" height="290" rx="16" ry="16"
          fill="rgba(120,53,15,0.18)" stroke="#D97706" stroke-width="1.5"
          filter="url(#shadow-md)"/>
    <rect x="1195" y="28" width="470" height="36" rx="16" ry="16" fill="url(#grad-amber)"/>
    <rect x="1195" y="46" width="470" height="18" fill="url(#grad-amber)"/>
    <text x="1430" y="52" text-anchor="middle" font-size="13" font-weight="700"
          fill="#FEF3C7" letter-spacing="0.5">BENCHMARK DATA</text>

    <!-- ADO Repo card -->
    <rect x="1215" y="76" width="210" height="110" rx="10"
          fill="url(#card-amber)" stroke="#D97706" stroke-width="1"
          filter="url(#shadow-sm)"
          data-tooltip="ado-repo" class="has-tooltip" style="cursor:pointer"/>
    <text x="1225" y="95" font-size="11" font-weight="700" fill="#FCD34D">ADO Repo</text>
    <text x="1225" y="110" font-size="10" fill="#FDE68A">Decisions.AI.Benchmarks</text>
    <text x="1225" y="126" font-size="9" fill="#D97706">All benchmark meeting data lives here</text>
    <text x="1225" y="140" font-size="9" fill="#D97706">in a fixed folder format per meeting</text>
    <text x="1225" y="155" font-size="9" fill="#D97706">• meeting.json + test-case.json</text>
    <text x="1225" y="169" font-size="9" fill="#D97706">• golden-output.txt</text>

    <!-- Arrow: ADO Repo → CI Pipeline — label outside cards with background -->
    <path d="M 1320 186 L 1320 200" stroke="#FBBF24" stroke-width="1.5"
          marker-end="url(#arrow-amber)" fill="none"/>
    <rect x="1322" y="186" width="75" height="13" rx="3" fill="rgba(15,23,42,0.85)"/>
    <text x="1359" y="196" text-anchor="middle" font-size="8.5" fill="#FBBF24">merge to main</text>

    <!-- CI Pipeline card -->
    <rect x="1215" y="200" width="210" height="70" rx="10"
          fill="url(#card-amber)" stroke="#D97706" stroke-width="1"
          filter="url(#shadow-sm)"
          data-tooltip="ci-pipeline" class="has-tooltip" style="cursor:pointer"/>
    <text x="1225" y="220" font-size="11" font-weight="700" fill="#FCD34D">CI Pipeline</text>
    <text x="1225" y="236" font-size="9.5" fill="#FDE68A">Uploads to Azure Blob Storage</text>
    <text x="1225" y="250" font-size="9.5" fill="#D97706">on every merge to main</text>

    <!-- Azure Blob Storage card -->
    <rect x="1445" y="76" width="200" height="108" rx="10"
          fill="url(#card-amber)" stroke="#D97706" stroke-width="1"
          filter="url(#shadow-sm)"
          data-tooltip="blob-storage" class="has-tooltip" style="cursor:pointer"/>
    <text x="1455" y="96" font-size="11" font-weight="700" fill="#FCD34D">Azure Blob Storage</text>
    <text x="1455" y="112" font-size="9.5" fill="#FDE68A">Single source of truth</text>
    <text x="1455" y="127" font-size="9.5" fill="#D97706">• Managed Identity access</text>
    <text x="1455" y="142" font-size="9.5" fill="#D97706">• Benchmark files store</text>
    <text x="1455" y="157" font-size="9.5" fill="#D97706">• CI writes on every merge</text>
    <text x="1455" y="172" font-size="9.5" fill="#D97706">• BenchmarkService reads</text>

    <!-- Arrow: CI Pipeline → Blob Storage — right-angle, label outside cards -->
    <path d="M 1425 235 L 1445 235 L 1445 184" stroke="#FBBF24" stroke-width="1.5"
          stroke-dasharray="5,3"
          marker-end="url(#arrow-amber)" fill="none"/>
    <rect x="1448" y="198" width="46" height="13" rx="3" fill="rgba(15,23,42,0.85)"/>
    <text x="1471" y="208" text-anchor="middle" font-size="8.5" fill="#FBBF24">uploads</text>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- SECTION 2: SURFACES (top-left, blue) — 4 SURFACES                 -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <rect x="18" y="28" width="660" height="360" rx="16" ry="16"
          fill="rgba(30,58,138,0.18)" stroke="#3B82F6" stroke-width="1.5"
          filter="url(#shadow-md)"/>
    <rect x="18" y="28" width="660" height="36" rx="16" ry="16" fill="url(#grad-blue)"/>
    <rect x="18" y="46" width="660" height="18" fill="url(#grad-blue)"/>
    <text x="348" y="52" text-anchor="middle" font-size="13" font-weight="700"
          fill="#DBEAFE" letter-spacing="0.5">4 SURFACES — EVAL ENTRY POINTS</text>

    <!-- Surface label badges -->
    <rect x="34" y="64" width="58" height="14" rx="4" fill="rgba(59,130,246,0.3)"/>
    <text x="63" y="74" text-anchor="middle" font-size="8" fill="#93C5FD" font-weight="700">S1</text>
    <rect x="200" y="64" width="58" height="14" rx="4" fill="rgba(59,130,246,0.3)"/>
    <text x="229" y="74" text-anchor="middle" font-size="8" fill="#93C5FD" font-weight="700">S2</text>
    <rect x="366" y="64" width="58" height="14" rx="4" fill="rgba(59,130,246,0.3)"/>
    <text x="395" y="74" text-anchor="middle" font-size="8" fill="#93C5FD" font-weight="700">S3</text>
    <rect x="542" y="64" width="58" height="14" rx="4" fill="rgba(59,130,246,0.3)"/>
    <text x="571" y="74" text-anchor="middle" font-size="8" fill="#93C5FD" font-weight="700">S4</text>

    <!-- S1: Scheduled Pipeline card -->
    <rect x="34" y="82" width="150" height="120" rx="10"
          fill="url(#card-blue)" stroke="#3B82F6" stroke-width="1"
          filter="url(#shadow-sm)"
          data-tooltip="scheduled-pipeline" class="has-tooltip" style="cursor:pointer"/>
    <text x="44" y="101" font-size="11" font-weight="700" fill="#93C5FD">Scheduled Pipeline</text>
    <text x="44" y="116" font-size="9.5" fill="#BFDBFE">ADO nightly YAML</text>
    <text x="44" y="131" font-size="9.5" fill="#60A5FA">• always: true</text>
    <text x="44" y="145" font-size="9.5" fill="#60A5FA">• Runs all benchmarks</text>
    <text x="44" y="159" font-size="9.5" fill="#60A5FA">• Results → Cosmos DB</text>
    <text x="44" y="173" font-size="9.5" fill="#60A5FA">• Official nightly run</text>
    <text x="44" y="190" font-size="8.5" fill="#4B72B0" font-style="italic">  + more config...</text>

    <!-- S2: PR Pipeline card -->
    <rect x="200" y="82" width="150" height="120" rx="10"
          fill="url(#card-blue)" stroke="#3B82F6" stroke-width="1"
          filter="url(#shadow-sm)"
          data-tooltip="pr-pipeline" class="has-tooltip" style="cursor:pointer"/>
    <text x="210" y="101" font-size="11" font-weight="700" fill="#93C5FD">PR Pipeline</text>
    <text x="210" y="116" font-size="9.5" fill="#BFDBFE">ADO PR YAML</text>
    <text x="210" y="131" font-size="9.5" fill="#60A5FA">• Auto-triggered on PR</text>
    <text x="210" y="145" font-size="9.5" fill="#60A5FA">• Path filter (prompt files)</text>
    <text x="210" y="159" font-size="9.5" fill="#60A5FA">• Posts eval report as</text>
    <text x="210" y="173" font-size="9.5" fill="#60A5FA">  PR comment</text>
    <text x="210" y="187" font-size="9.5" fill="#60A5FA">• Flags regressions</text>

    <!-- S3: Dev Playground card -->
    <!-- Change A: Angular not React. Change I: added "+ more features" hint. Extended h=140 -->
    <rect x="366" y="82" width="160" height="140" rx="10"
          fill="url(#card-blue)" stroke="#3B82F6" stroke-width="1"
          filter="url(#shadow-sm)"
          data-tooltip="dev-playground" class="has-tooltip" style="cursor:pointer"/>
    <text x="376" y="101" font-size="11" font-weight="700" fill="#93C5FD">Dev Playground</text>
    <text x="376" y="116" font-size="9.5" fill="#BFDBFE">Angular page — Decisions.Web</text>
    <text x="376" y="131" font-size="9.5" fill="#60A5FA">• One-click Run All</text>
    <text x="376" y="145" font-size="9.5" fill="#60A5FA">• SSE live progress</text>
    <text x="376" y="159" font-size="9.5" fill="#60A5FA">• Scores + reasons display</text>
    <text x="376" y="173" font-size="9.5" fill="#60A5FA">• Export results</text>
    <text x="376" y="187" font-size="9.5" fill="#60A5FA">• Eval Sandbox mode</text>
    <text x="376" y="208" font-size="8.5" fill="#4B72B0" font-style="italic">  + more features...</text>

    <!-- Change D: IndexedDB card — now inside Surfaces section, below Dev Playground -->
    <!-- Change C: "Persists between page reloads" (not "Cleared on page reload") -->
    <rect x="366" y="232" width="160" height="106" rx="10"
          fill="url(#card-blue)" stroke="#60A5FA" stroke-width="1" stroke-dasharray="5,3"
          filter="url(#shadow-sm)"
          data-tooltip="indexed-db" class="has-tooltip" style="cursor:pointer"/>
    <text x="376" y="249" font-size="10" font-weight="700" fill="#93C5FD">IndexedDB (Dexie.js)</text>
    <text x="376" y="263" font-size="9" fill="#BFDBFE">🌐 Browser-side storage</text>
    <text x="376" y="277" font-size="9" fill="#60A5FA">• Dev Playground runs only</text>
    <text x="376" y="291" font-size="9" fill="#60A5FA">• Persists between page reloads</text>
    <text x="376" y="305" font-size="9" fill="#60A5FA">• No server persistence</text>
    <text x="376" y="319" font-size="9" fill="#60A5FA">• GDPR safe (synthetic data)</text>

    <!-- Arrow: Dev Playground → IndexedDB (short connector) -->
    <path d="M 446 222 L 446 232" stroke="#60A5FA" stroke-width="1.5"
          stroke-dasharray="4,2"
          marker-end="url(#arrow-blue)" fill="none"/>

    <!-- S4: Production card -->
    <rect x="542" y="82" width="120" height="150" rx="10"
          fill="url(#card-blue)" stroke="#3B82F6" stroke-width="1"
          filter="url(#shadow-sm)"
          data-tooltip="production" class="has-tooltip" style="cursor:pointer"/>
    <text x="552" y="101" font-size="11" font-weight="700" fill="#93C5FD">Production</text>
    <text x="552" y="116" font-size="9.5" fill="#BFDBFE">Live traffic sampling</text>
    <text x="552" y="131" font-size="9.5" fill="#60A5FA">• Recap / Minutes</text>
    <text x="552" y="145" font-size="9.5" fill="#60A5FA">• ~5% sampled</text>
    <text x="552" y="159" font-size="9.5" fill="#60A5FA">• Fire &amp; forget</text>
    <text x="552" y="175" font-size="9.5" fill="#EF4444">• GDPR: local mode</text>
    <text x="552" y="189" font-size="9.5" fill="#EF4444">  only (locked)</text>
    <text x="552" y="205" font-size="9.5" fill="#EF4444">• Real customer data</text>
    <text x="552" y="220" font-size="9.5" fill="#EF4444">• Transcript discarded</text>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- SECTION 3: MeetingCulture.AI.API (center, green) y=410            -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <rect x="18" y="408" width="1140" height="340" rx="16" ry="16"
          fill="rgba(6,78,59,0.18)" stroke="#10B981" stroke-width="1.5"
          filter="url(#shadow-md)"/>
    <rect x="18" y="408" width="1140" height="36" rx="16" ry="16" fill="url(#grad-green)"/>
    <rect x="18" y="426" width="1140" height="18" fill="url(#grad-green)"/>
    <text x="588" y="431" text-anchor="middle" font-size="13" font-weight="700"
          fill="#D1FAE5" letter-spacing="0.5">MeetingCulture.AI.API — .NET 8</text>

    <!-- BenchmarkController card -->
    <!-- Change H: added "+ and more endpoints..." hint -->
    <rect x="34" y="456" width="220" height="150" rx="10"
          fill="url(#card-green)" stroke="#10B981" stroke-width="1"
          filter="url(#shadow-sm)"
          data-tooltip="benchmark-controller" class="has-tooltip" style="cursor:pointer"/>
    <text x="44" y="475" font-size="11" font-weight="700" fill="#6EE7B7">BenchmarkController</text>
    <text x="44" y="491" font-size="9.5" fill="#A7F3D0">HTTP + SSE endpoints</text>
    <text x="44" y="507" font-size="9.5" fill="#34D399">GET /api/Benchmark/meetings</text>
    <text x="44" y="522" font-size="9.5" fill="#34D399">POST /api/Benchmark/run (SSE)</text>
    <text x="44" y="537" font-size="9.5" fill="#34D399">POST /api/Benchmark/adhoc</text>
    <text x="44" y="552" font-size="9.5" fill="#34D399">POST /api/Benchmark/stop</text>
    <text x="44" y="568" font-size="8.5" fill="#34D399" font-style="italic">  + and more endpoints...</text>
    <text x="44" y="584" font-size="9.5" fill="#059669">Entry point for all 4 surfaces</text>

    <!-- BenchmarkService card -->
    <rect x="280" y="456" width="240" height="170" rx="10"
          fill="url(#card-green)" stroke="#10B981" stroke-width="1"
          filter="url(#shadow-sm)"
          data-tooltip="benchmark-service" class="has-tooltip" style="cursor:pointer"/>
    <text x="290" y="475" font-size="11" font-weight="700" fill="#6EE7B7">BenchmarkService</text>
    <text x="290" y="491" font-size="9.5" fill="#A7F3D0">Core orchestration logic</text>
    <text x="290" y="507" font-size="9.5" fill="#34D399">• Fetches from Blob (MI)</text>
    <text x="290" y="522" font-size="9.5" fill="#34D399">• SemaphoreSlim max 5</text>
    <text x="290" y="537" font-size="9.5" fill="#34D399">• Orchestrates parallel runs</text>
    <text x="290" y="552" font-size="9.5" fill="#34D399">• Calls Recap/MinutesService</text>
    <text x="290" y="567" font-size="9.5" fill="#34D399">• Calls EvalServiceClient</text>
    <text x="290" y="582" font-size="9.5" fill="#34D399">• Stores results (Cosmos/IDB)</text>
    <text x="290" y="597" font-size="9.5" fill="#059669">• SSE progress streaming</text>
    <text x="290" y="612" font-size="9.5" fill="#059669">• Cancellation token support</text>

