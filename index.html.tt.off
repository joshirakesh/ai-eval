<div id="tooltip"><div id="tooltip-inner"></div></div>

<script>
// ─── Pan & Zoom ───────────────────────────────────────────────────────────────
const wrap = document.getElementById('canvas-wrap');
const svg  = document.getElementById('svg-root');
const zoomDisplay = document.getElementById('zoomDisplay');

let scale = 0.72, tx = 0, ty = 0;
let dragging = false, startX = 0, startY = 0, startTx = 0, startTy = 0;

function applyTransform() {
  svg.style.transform = `translate(${tx}px, ${ty}px) scale(${scale})`;
  zoomDisplay.textContent = Math.round(scale * 100) + '%';
}

function centerFit() {
  const vw = window.innerWidth, vh = window.innerHeight;
  const svgW = 1700, svgH = 1060;
  const s = Math.min((vw - 40) / svgW, (vh - 80) / svgH);
  scale = Math.round(s * 100) / 100;
  tx = (vw - svgW * scale) / 2;
  ty = (vh - svgH * scale) / 2;
  applyTransform();
}

centerFit();
window.addEventListener('resize', centerFit);

wrap.addEventListener('mousedown', e => {
  dragging = true;
  startX = e.clientX; startY = e.clientY;
  startTx = tx; startTy = ty;
  wrap.classList.add('dragging');
});
window.addEventListener('mousemove', e => {
  if (!dragging) return;
  tx = startTx + (e.clientX - startX);
  ty = startTy + (e.clientY - startY);
  applyTransform();
});
window.addEventListener('mouseup', () => { dragging = false; wrap.classList.remove('dragging'); });

wrap.addEventListener('wheel', e => {
  e.preventDefault();
  const delta = e.deltaY > 0 ? 0.9 : 1.1;
  const rect = wrap.getBoundingClientRect();
  const mx = e.clientX - rect.left, my = e.clientY - rect.top;
  const newScale = Math.min(Math.max(scale * delta, 0.15), 4);
  tx = mx - (mx - tx) * (newScale / scale);
  ty = my - (my - ty) * (newScale / scale);
  scale = newScale;
  applyTransform();
}, { passive: false });

document.getElementById('btnZoomIn').addEventListener('click', () => {
  const cx = window.innerWidth / 2, cy = window.innerHeight / 2;
  const newScale = Math.min(scale * 1.2, 4);
  tx = cx - (cx - tx) * (newScale / scale);
  ty = cy - (cy - ty) * (newScale / scale);
  scale = newScale; applyTransform();
});
document.getElementById('btnZoomOut').addEventListener('click', () => {
  const cx = window.innerWidth / 2, cy = window.innerHeight / 2;
  const newScale = Math.max(scale / 1.2, 0.15);
  tx = cx - (cx - tx) * (newScale / scale);
  ty = cy - (cy - ty) * (newScale / scale);
  scale = newScale; applyTransform();
});
document.getElementById('btnReset').addEventListener('click', centerFit);

// Touch support
let lastTouchDist = null;
wrap.addEventListener('touchstart', e => {
  if (e.touches.length === 1) {
    dragging = true;
    startX = e.touches[0].clientX; startY = e.touches[0].clientY;
    startTx = tx; startTy = ty;
  } else if (e.touches.length === 2) {
    const dx = e.touches[0].clientX - e.touches[1].clientX;
    const dy = e.touches[0].clientY - e.touches[1].clientY;
    lastTouchDist = Math.hypot(dx, dy);
  }
}, { passive: true });
wrap.addEventListener('touchmove', e => {
  e.preventDefault();
  if (e.touches.length === 1 && dragging) {
    tx = startTx + (e.touches[0].clientX - startX);
    ty = startTy + (e.touches[0].clientY - startY);
    applyTransform();
  } else if (e.touches.length === 2 && lastTouchDist) {
    const dx = e.touches[0].clientX - e.touches[1].clientX;
    const dy = e.touches[0].clientY - e.touches[1].clientY;
    const dist = Math.hypot(dx, dy);
    const delta = dist / lastTouchDist;
    const cx = (e.touches[0].clientX + e.touches[1].clientX) / 2;
    const cy = (e.touches[0].clientY + e.touches[1].clientY) / 2;
    const newScale = Math.min(Math.max(scale * delta, 0.15), 4);
    tx = cx - (cx - tx) * (newScale / scale);
    ty = cy - (cy - ty) * (newScale / scale);
    scale = newScale; lastTouchDist = dist;
    applyTransform();
  }
}, { passive: false });
wrap.addEventListener('touchend', () => { dragging = false; lastTouchDist = null; });

// ─── Tooltip Toggle ───────────────────────────────────────────────────────────
let tooltipsEnabled = false;
const btnTooltipToggle = document.getElementById('btnTooltipToggle');
const tooltip = document.getElementById('tooltip');
const tooltipInner = document.getElementById('tooltip-inner');

btnTooltipToggle.addEventListener('click', () => {
  tooltipsEnabled = !tooltipsEnabled;
  btnTooltipToggle.textContent = tooltipsEnabled ? '💬 Tooltips: ON' : '💬 Tooltips: OFF';
  btnTooltipToggle.style.background = tooltipsEnabled
    ? 'rgba(59,130,246,0.5)'
    : 'rgba(51,65,85,0.8)';
  if (!tooltipsEnabled) tooltip.classList.remove('visible');
});

// ─── Tooltips ─────────────────────────────────────────────────────────────────
const tooltipData = {
  'ado-repo': {
    title: 'ADO Repo: Decisions.AI.Benchmarks',
    body: 'Azure DevOps Git repository containing all benchmark test data. Each benchmark is a folder with three files:\n• meeting.json — transcript with speaker turns, timestamps, and meeting metadata\n• test-case.json — which feature to test (Recap or Minutes), expected behaviour, tags\n• golden-output.txt — human-written reference answer for scoring\n\nMerging to main triggers the CI pipeline which syncs files to Blob Storage.'
  },
  'dataset-profile': {
    title: 'Benchmark Dataset Profile',
    body: 'Target: 20–30 high-quality curated benchmark meetings.\n\nMeeting types: 1:1, team standups, client meetings, project reviews, all-hands\n\nDuration coverage: short (<30 min), medium (30–60 min), long (>60 min)\n\nSpeaker count: 2 to 10+ speakers per meeting\n\nEdge cases included:\n• Meeting with no decisions made\n• Single dominant speaker (90%+ of content)\n• Very short meeting (<5 min)\n• Very dense meeting (many action items)\n• Multi-language mixed meeting\n\nTranscripts must be anonymised or synthetic — no real personal data in the repo.'
  },
  'ci-pipeline': {
    title: 'CI Pipeline',
    body: 'Azure DevOps pipeline that runs on every merge to main. Automatically uploads the latest benchmark files to Azure Blob Storage, ensuring the single source of truth is always current. No manual steps required.'
  },
  'blob-storage': {
    title: 'Azure Blob Storage — Benchmark Store',
    body: 'Single source of truth for all benchmark files. BenchmarkService reads from here at runtime using Managed Identity (no connection strings or secrets). Updated by CI on every merge to main. Isolated from production transcript storage.'
  },
  'scheduled-pipeline': {
    title: 'S1 — Scheduled Pipeline (ADO YAML)',
    body: 'Nightly ADO pipeline with "always: true" so it never skips even if no code changes. Runs the full benchmark suite across all test cases. Results are stored to Cosmos DB as the official nightly baseline. Used to track quality trends over time.'
  },
  'pr-pipeline': {
    title: 'S2 — PR Pipeline (ADO YAML)',
    body: 'Automatically triggered on every Pull Request. Uses path filters to only trigger when prompt-related files change. Runs the benchmark suite and posts a structured eval report as a PR comment. Flags any regressions compared to the main branch baseline. Can block merge if configured thresholds are breached.'
  },
  'dev-playground': {
    title: 'S3 — Dev Playground (Angular — Decisions.Web)',
    body: 'Angular page in Decisions.Web for developers. Features: one-click "Run All" benchmarks, real-time SSE progress streaming, scores and reasons displayed inline, export to CSV/JSON, and a sandbox mode for ad-hoc evaluation without saving. Results stored in IndexedDB (browser-side, persists between page reloads).'
  },
  'indexed-db': {
    title: 'IndexedDB (Dexie.js) — Browser Storage',
    body: 'Client-side storage for the Dev Playground. Uses Dexie.js wrapper for clean async API. Stores results in the browser — persists between page reloads but never sent to any server. Not an Azure service. No GDPR concerns as Dev Playground only runs against synthetic benchmark data, never real customer transcripts.'
  },
  'production': {
    title: 'S4 — Production Surface — Live Traffic Sampling',
    body: 'Real Recap and Minutes requests from live customers. ~5% are sampled for evaluation using ShouldSample() logic. GDPR Decision 5 (Locked): local evaluation mode ONLY. No real transcript data leaves the service boundary. Results stored to Cosmos DB. Raw transcripts discarded immediately after eval.'
  },
  'benchmark-controller': {
    title: 'BenchmarkController (.NET 8)',
    body: 'ASP.NET Core controller — single entry point for all 4 surfaces.\n\nKey endpoints:\n• GET /api/Benchmark/meetings — list available test cases\n• POST /api/Benchmark/run — run benchmarks with SSE streaming\n• POST /api/Benchmark/adhoc — run a single ad-hoc eval\n• POST /api/Benchmark/stop — cancel a running session\n...and more endpoints as the system grows.'
  },
  'benchmark-service': {
    title: 'BenchmarkService',
    body: 'Core orchestration service. Fetches benchmark files from Blob Storage via Managed Identity. Uses SemaphoreSlim(5) for parallel run limiting. Calls the appropriate RecapService or MinutesService endpoint, then calls EvalServiceClient for scoring. Streams progress via SSE. Stores results to Cosmos DB (official runs) or IndexedDB (dev playground runs).'
  },
  'recap-minutes': {
    title: 'RecapService / MinutesService (Existing)',
    body: 'Decision 8 (Locked): No code duplication. The exact same /api/MeetingRecap and /api/MeetingMinutes endpoints used in production are called during evaluation. This ensures benchmark results reflect real production behaviour, not a parallel implementation.'
  },
  'eval-client': {
    title: 'EvalServiceClient',
    body: 'HTTP client wrapper using IHttpClientFactory named client pattern. API Key retrieved from Azure Key Vault at startup via Managed Identity. Calls EvalService endpoints:\n• POST /evaluate — standard batch evaluation\n• POST /evaluate/adhoc — single case evaluation\nInternal ingress only — not publicly accessible.'
  },
  'prod-sampling': {
    title: 'ProductionSamplingService',
    body: 'Handles background eval of real production traffic. Uses "_ = EvalAndStoreAsync()" fire-and-forget pattern to avoid blocking the user response.\n\nShouldSample() rules:\n• Skip excluded tenants\n• Boost new model rollouts\n• Always sample first 20 requests from new tenants\n• Daily cap per tenant\n• 5% random baseline\n\nGDPR: transcript discarded immediately after eval. Local mode enforced.'
  },
  'evaluate-endpoint': {
    title: 'EvalService API Endpoints',
    body: 'FastAPI application deployed on Azure Container Apps with scale-to-zero.\n• POST /evaluate — evaluate a batch of test cases\n• POST /evaluate/adhoc — evaluate a single case on demand\nAuthentication: API Key (stored in Key Vault). Internal ingress only — not reachable from the public internet.'
  },
  'custom-evaluator': {
    title: 'CustomEvaluator (Python)',
    body: 'Generic Python evaluator class. Loads metric definitions from .txt prompt files at startup. Uses Azure AI Evaluation SDK in LOCAL MODE ONLY — never cloud mode. Implements G-Eval (LLM-as-Judge) pattern: sends transcript + output + golden answer + prompt to Azure OpenAI, receives score (1–5) and a human-readable reason. Adding a new metric requires only a new .txt file — no code changes.'
  },
  'eval-prompts': {
    title: 'Eval Prompt Files (.txt)',
    body: 'Plain text files defining evaluation rubrics for the LLM judge.\n\nBase: groundedness.txt, coherence.txt, fluency.txt\n\nFeature-specific: completeness.txt, action_item_capture.txt, decision_capture.txt\n\nInput-specific: multi_speaker_coverage.txt, minutes_style_fidelity.txt\n\nExtensible: drop a new .txt file in the prompts folder to add a metric — no code changes required.'
  },
  'ai-eval-sdk': {
    title: 'Azure AI Evaluation SDK',
    body: 'Microsoft\'s official evaluation SDK. Configured in LOCAL MODE ONLY as required by Decision 5 (Locked). In local mode, the LLM judge call goes directly to our own Azure OpenAI deployment without any data leaving our tenant. Cloud mode (which would send data to Microsoft\'s shared eval infrastructure) is permanently banned for any surface touching real customer data.'
  },
  'cosmos-db': {
    title: 'Cosmos DB — Results Store',
    body: 'Stores evaluation scores and metadata only. Explicitly no raw transcripts stored (GDPR compliance). Receives results from three official surfaces: PR Pipeline runs, Scheduled nightly runs, and Production sampling. Accessed via Managed Identity. Used for trend analysis, regression detection, and quality reporting.'
  },
  'key-vault': {
    title: 'Azure Key Vault',
    body: 'Centralized secret storage. Holds the EvalService API Key used by EvalServiceClient. All access via Managed Identity — no connection strings or credentials in application config or environment variables. Rotated on a schedule without application changes.'
  },
  'azure-openai': {
    title: 'Azure OpenAI — LLM Judge (Dedicated Eval Deployment)',
    body: 'A DEDICATED Azure OpenAI deployment used exclusively for evaluation — this is NOT the same deployment used in production for Recap/Minutes generation. Keeping them separate ensures eval load does not affect production latency and vice versa. Called in local mode only via the Azure AI Evaluation SDK. GDPR compliant: data stays within our Azure tenant. Provides scores 1–5 and human-readable reason strings for each metric.'
  }
};

document.querySelectorAll('.has-tooltip').forEach(el => {
  el.addEventListener('mouseenter', e => {
    if (!tooltipsEnabled) return;
    const key = el.getAttribute('data-tooltip');
    const data = tooltipData[key];
    if (!data) return;
    tooltipInner.innerHTML = `<strong>${data.title}</strong>${data.body.replace(/\n/g, '<br>')}`;
    tooltip.classList.add('visible');
    positionTooltip(e);
  });
  el.addEventListener('mousemove', e => {
    if (!tooltipsEnabled) return;
    positionTooltip(e);
  });
  el.addEventListener('mouseleave', () => tooltip.classList.remove('visible'));
});

function positionTooltip(e) {
  const pad = 14;
  const tw = tooltip.offsetWidth || 280;
  const th = tooltip.offsetHeight || 100;
  let x = e.clientX + pad;
  let y = e.clientY + pad;
  if (x + tw > window.innerWidth - 10) x = e.clientX - tw - pad;
  if (y + th > window.innerHeight - 10) y = e.clientY - th - pad;
  tooltip.style.left = x + 'px';
  tooltip.style.top  = y + 'px';
}
</script>
</body>
</html>
